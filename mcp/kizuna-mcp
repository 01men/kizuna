// ---------------------------------------------------------------------------
// 工具实现
// ---------------------------------------------------------------------------

const text = (v) => ({ content: [{ type: 'text', text: typeof v === 'string' ? v : JSON.stringify(v, null, 2) }] });

async function handleTool(cfg, name, args) {
  switch (name) {
    case 'kizuna_list_agents': {
      const p = new URLSearchParams();
      if (args.q) p.set('q', String(args.q));
      if (args.tag) p.set('tag', String(args.tag));
      if (args.status) p.set('status', String(args.status));
      p.set('limit', String(Math.min(Number(args.limit) || 50, 200)));
      const r = await call(cfg, { path: `/api/v1/agents?${p}` });
      return text(r.items.map((a) => ({
        agent_id: a.agent_id, name: a.name, capabilities: a.capabilities, tags: a.capability_tags,
        status: a.status, enabled: a.enabled, has_agent_card: Boolean(a.agent_card),
      })).concat([{ total: r.total }]));
    }
    case 'kizuna_get_agent': {
      return text(await call(cfg, { path: `/api/v1/agents/${encodeURIComponent(args.agent_id)}` }));
    }
    case 'kizuna_send_task': {
      const content = { body: args.body };
      if (args.title) content.title = String(args.title);
      if (args.format) content.format = String(args.format);
      else if (typeof args.body === 'object') content.format = 'json';
      if (args.priority) content.priority = String(args.priority);
      if (args.deadline) content.deadline = String(args.deadline);
      return text(await call(cfg, { method: 'POST', path: '/api/v1/tasks', body: { to: args.to, content } }));
    }
    case 'kizuna_get_task': {
      return text(await call(cfg, { path: `/api/v1/tasks/${encodeURIComponent(args.task_id)}` }));
    }
    case 'kizuna_list_my_letters': {
      return text(await boxCall(cfg, { path: '/tasks/pending' }));
    }
    case 'kizuna_read_letter': {
      return text(await boxCall(cfg, { path: `/tasks/${encodeURIComponent(args.task_id)}` }));
    }
    case 'kizuna_complete_letter': {
      return text(await boxCall(cfg, { method: 'POST', path: `/tasks/${encodeURIComponent(args.task_id)}/complete`, body: {} }));
    }
    case 'kizuna_report_result': {
      // 优先走本机 box（它会用端侧令牌转发，且能顺带归档信件）；无 box 时直连 Hub
      const payload = { state: args.state };
      if (args.message !== undefined) payload.message = String(args.message);
      if (args.result !== undefined) payload.result = args.result;
      if (args.suppress_reply !== undefined) payload.suppress_reply = Boolean(args.suppress_reply);
      try {
        return text(await boxCall(cfg, { method: 'POST', path: `/tasks/${encodeURIComponent(args.task_id)}/result`, body: payload }));
      } catch (e) {
        if (!cfg.agentToken) throw e;
        return text(await call(cfg, { method: 'POST', path: `/api/v1/tasks/${encodeURIComponent(args.task_id)}/result`, body: payload }));
      }
    }
    case 'kizuna_get_results': {
      return text(await call(cfg, { path: `/api/v1/tasks/${encodeURIComponent(args.task_id)}/result` }));
    }
    case 'kizuna_get_agent_card': {
      const p = args.agent_id ? `/.well-known/agent-card.json?agent=${encodeURIComponent(args.agent_id)}` : '/.well-known/agent-card.json';
      const res = await fetch(cfg.hubUrl + p, { signal: AbortSignal.timeout(15000) });
      const body = await res.json();
      if (!res.ok) throw new Error(`${res.status} ${body?.error?.code ?? ''} ${body?.error?.message ?? ''}`.trim());
      return text(body);
    }
    case 'kizuna_whoami': {
      return text({
        hub_url: cfg.hubUrl || '(未配置)',
        agent_id: cfg.agentId || '(未知)',
        has_agent_token: Boolean(cfg.agentToken),
        has_admin_token: Boolean(cfg.adminToken),
        box_url: cfg.boxUrl,
        version: VERSION,
      });
    }
    default:
      throw new Error(`未知工具: ${name}`);
  }
}

// ---------------------------------------------------------------------------
// JSON-RPC over stdio
// ---------------------------------------------------------------------------

function send(msg) {
  process.stdout.write(JSON.stringify(msg) + '\n');
}

async function handleRpc(cfg, req) {
  const { id, method, params } = req;
  const isNotification = id === undefined || id === null;
  try {
    switch (method) {
      case 'initialize':
        return send({
          jsonrpc: '2.0', id,
          result: {
            protocolVersion: PROTOCOL_VERSION,
            capabilities: { tools: { listChanged: false } },
            serverInfo: { name: 'kizuna', version: VERSION },
            instructions:
              'Kizuna 是 Agent 通讯录与可靠任务投递网络。用 kizuna_list_agents 找目标 Agent，' +
              'kizuna_send_task 发任务（支持 A2A Message），kizuna_list_my_letters 读自己的信箱，' +
              'kizuna_report_result 回传结果（终态自动回执发起方）。',
          },
        });
      case 'notifications/initialized':
      case 'initialized':
        return undefined; // 通知：不响应
      case 'ping':
        return send({ jsonrpc: '2.0', id, result: {} });
      case 'tools/list':
        return send({ jsonrpc: '2.0', id, result: { tools: TOOLS } });
      case 'tools/call': {
        const name = params?.name;
        const args = params?.arguments ?? {};
        const tool = TOOLS.find((t) => t.name === name);
        if (!tool) throw new Error(`未知工具: ${name}`);
        const out = await handleTool(cfg, name, args);
        return send({ jsonrpc: '2.0', id, result: out });
      }
      case 'resources/list':
        return send({ jsonrpc: '2.0', id, result: { resources: [] } });
      case 'prompts/list':
        return send({ jsonrpc: '2.0', id, result: { prompts: [] } });
      default:
        if (isNotification) return undefined;
        return send({ jsonrpc: '2.0', id, error: { code: -32601, message: `Method not found: ${method}` } });
    }
  } catch (e) {
    if (isNotification) return undefined;
    return send({
      jsonrpc: '2.0', id,
      result: { isError: true, content: [{ type: 'text', text: `错误: ${e instanceof Error ? e.message : String(e)}` }] },
    });
  }
  return undefined;
}

async function selftest() {
  const cfg = loadConfig();
  console.log(`kizuna-mcp v${VERSION}`);
  console.log(`hub_url        : ${cfg.hubUrl || '(未配置)'}`);
  console.log(`agent_id       : ${cfg.agentId || '(未知)'}`);
  console.log(`agent_token    : ${cfg.agentToken ? '已配置' : '(未配置)'}`);
  console.log(`box_url        : ${cfg.boxUrl}`);
  console.log(`tools (${TOOLS.length})     : ${TOOLS.map((t) => t.name).join(', ')}`);
  if (cfg.hubUrl) {
    try {
      const r = await fetch(`${cfg.hubUrl}/healthz`, { signal: AbortSignal.timeout(10000) });
      console.log(`hub healthz    : ${r.status} ${(await r.text()).slice(0, 120)}`);
    } catch (e) {
      console.log(`hub healthz    : 失败 ${e.message}`);
    }
  }
}

function main() {
  if (process.argv.includes('--selftest')) {
    selftest().catch((e) => { console.error(e.message); process.exit(1); });
    return;
  }
  if (process.argv.includes('--version')) {
    console.log(`kizuna-mcp v${VERSION}`);
    return;
  }
  const cfg = loadConfig();
  process.stderr.write(`[kizuna-mcp] v${VERSION} ready · hub=${cfg.hubUrl || '(未配置)'} agent=${cfg.agentId || '(未知)'}\n`);
  const rl = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });
  let chain = Promise.resolve();
  rl.on('line', (line) => {
    const trimmed = line.trim();
    if (!trimmed) return;
    let req;
    try { req = JSON.parse(trimmed); } catch { return; }
    // 串行处理，避免工具调用交错写 stdout
    chain = chain.then(() => handleRpc(cfg, req)).catch(() => undefined);
  });
}

main();