#!/usr/bin/env node
/*
 * kizuna-mcp — MCP server for the Kizuna agent directory & task relay
 *
 * 零 npm 依赖（仅 node:*），JSON-RPC 2.0 over stdio（MCP 规范 2024-11-05）。
 * 让任何支持 MCP 的 Agent（Claude Desktop / Cursor / DSH / …）直接：
 *   发现 Agent → 发信 → 读信箱 → 回执 → 回传结果
 *
 * 配置（任一来源，优先级从高到低）：
 *   环境变量  KIZUNA_HUB_URL、KIZUNA_AGENT_TOKEN、KIZUNA_ADMIN_TOKEN、KIZUNA_BOX_URL
 *   配置文件  ~/.kizuna-box/config.json（安装脚本会写好 hub_url / agent_token）
 *
 * 用法：
 *   npx -y kizuna-mcp                      # stdio，供 MCP 客户端拉起
 *   kizuna-mcp --selftest                  # 打印工具清单与连通性（人工排障）
 */
'use strict';

const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const readline = require('node:readline');

const VERSION = '0.2.0';
const PROTOCOL_VERSION = '2024-11-05';

// ---------------------------------------------------------------------------
// 配置
// ---------------------------------------------------------------------------

function loadConfig() {
  const cfgPath = process.env.KIZUNA_BOX_CONFIG ?? path.join(os.homedir(), '.kizuna-box', 'config.json');
  let file = {};
  try { file = JSON.parse(fs.readFileSync(cfgPath, 'utf8')); } catch { /* 未安装端侧服务 */ }
  return {
    hubUrl: (process.env.KIZUNA_HUB_URL || file.hub_url || '').replace(/\/+$/, ''),
    agentToken: process.env.KIZUNA_AGENT_TOKEN || file.agent_token || '',
    adminToken: process.env.KIZUNA_ADMIN_TOKEN || '',
    boxUrl: (process.env.KIZUNA_BOX_URL || `http://127.0.0.1:${file.listen?.port ?? 7788}`).replace(/\/+$/, ''),
    agentId: file.agent_id || '',
  };
}

async function call(cfg, { method = 'GET', path: p, body, auth = 'agent', timeoutMs = 20000 }) {
  const base = cfg.hubUrl;
  if (!base) throw new Error('未配置 hub：设置 KIZUNA_HUB_URL 或先运行安装脚本生成 ~/.kizuna-box/config.json');
  const token = auth === 'admin' ? cfg.adminToken : cfg.agentToken;
  if (!token) throw new Error(`缺少${auth === 'admin' ? '管理员' : ' Agent'}令牌：设置 KIZUNA_${auth === 'admin' ? 'ADMIN' : 'AGENT'}_TOKEN`);
  const res = await fetch(base + p, {
    method,
    headers: { 'content-type': 'application/json', authorization: `Bearer ${token}` },
    body: body === undefined ? undefined : JSON.stringify(body),
    signal: AbortSignal.timeout(timeoutMs),
  });
  const text = await res.text();
  let json;
  try { json = JSON.parse(text); } catch { json = { raw: text.slice(0, 2000) }; }
  if (!res.ok) {
    const err = json?.error ?? {};
    throw new Error(`${res.status} ${err.code ?? ''} ${err.message ?? text.slice(0, 200)}`.trim());
  }
  return json;
}

async function boxCall(cfg, { method = 'GET', path: p, body }) {
  const res = await fetch(cfg.boxUrl + p, {
    method,
    headers: { 'content-type': 'application/json' },
    body: body === undefined ? undefined : JSON.stringify(body),
    signal: AbortSignal.timeout(10000),
  });
  const text = await res.text();
  let json;
  try { json = JSON.parse(text); } catch { json = { raw: text.slice(0, 2000) }; }
  if (!res.ok) throw new Error(`${res.status} ${json?.error?.message ?? text.slice(0, 200)}`);
  return json;
}

// ---------------------------------------------------------------------------
// 工具定义
// ---------------------------------------------------------------------------

